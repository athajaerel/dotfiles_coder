# Slightly more helpful prompt
PS1='$(if [[ $? -gt 0 ]]; then echo -e "\[\e[0;31m\]# :("; else echo "\[\e[0;32m\]# :)"; fi) @\h:\W\[\e[0m\] $ '

# Path adds
PATH=$PATH:$HOME/.local/bin
PATH=$PATH:$HOME/bin
export PATH

# Workspace builds from scratch every time, so we need to install packages
MYPKGS='golang golang-github-jinzhu-gorm-dev golang-github-mattn-go-sqlite3-dev'
sudo apt-get install -y ${MYPKGS}

# Aliases
TENANTID='b8b4c61c-f1ca-4aff-a0bd-9c6f01c3eca5'
unalias -a
alias biggest='nice -n 19 du -mx . | sort -rn | head'
alias dotfiles='/usr/bin/git --git-dir=$HOME/.dotfiles --work-tree=$HOME'
alias azl="az login --use-device-code --tenant ${TENANTID}"

# Screen saver
SOCK="/tmp/ssh-agent-$USER-screen"
if [ $SSH_AUTH_SOCK ] && [ $SSH_AUTH_SOCK != $SOCK ]; then
	rm -f $SOCK
	ln -sf $SSH_AUTH_SOCK $SOCK
	export SSH_AUTH_SOCK=$SOCK
fi

# Haz screens?
screen -ls | grep -q "^No Sockets found"
[[ $? -gt 0 ]] && echo "You have active screen sessions."

# No duplicates in history
HISTCONTROL=ignoreboth:erasedups

# Append to the history file instead of overwriting it
shopt -s histappend

# Keep lots of history
export HISTSIZE=100000
export HISTFILESIZE=10000000
export PROMPT_COMMAND='history -a'

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# Start ssh-agent
eval $(ssh-agent)

# Predictable SSH agent filename
SOCK="/tmp/ssh-agent-$USER-screen"
if [ $SSH_AUTH_SOCK ] && [ $SSH_AUTH_SOCK != $SOCK ]; then
        rm -f $SOCK
        ln -sf $SSH_AUTH_SOCK $SOCK
        export SSH_AUTH_SOCK=$SOCK
fi

# this one contains secrets, it dies when the laptop dies --- do not push
if [ -f ~/.bashrc-secrets ]; then
        . ~/.bashrc-secrets
fi

# Go settings
export GOPATH=$HOME/go

# vim: set filetype=sh
